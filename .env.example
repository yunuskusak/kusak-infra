# KUSAK-INFRA — Ortam değişkenleri ŞABLONU (yalnız yer tutucu değerler)
# Kullanım:  cp .env.example .env   ve değerleri kendi TESTNET anahtarlarınızla doldurun.
# .env dosyası .gitignore ile hariç tutulur; asla commit etmeyin.
#
# UYARI: Bu proje arşivdir. Açık P0 güvenlik bulguları (KZ-P0-01/02/03) nedeniyle
# gerçek para ile (dry_run=false + testnet=false) çalıştırılmamalıdır. README.md'ye bakın.

# Binance API anahtarları. src/main.cpp config dosyasındaki api_key/api_secret
# alanlarını bu değişkenlerle ezer; tools/mvp_order_bridge_test.cpp bunları okur.
API_KEY="YOUR_API_KEY"
API_SECRET="YOUR_API_SECRET"

# Config'teki testnet alanını ezer (src/main.cpp).
# true/1/TRUE/EVET -> testnet ; false/0/FALSE/HAYIR -> MAINNET (gerçek borsa).
TESTNET="true"

# research --record modu için sembol (varsayılan: BTCUSDT)
SYMBOL=BTCUSDT

# Bildirimler (include/notification.hpp). Motorda bağlı değil; boş bırakılabilir.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SLACK_WEBHOOK=""
SLACK_CHANNEL="#kusak-alerts"
NOTIFY_WEBHOOK=""
